#!/usr/bin/env bash
# ==============================================================================
# tmux-phoenix: Zero-Loss Tmux Session Persistence, Recovery & Snapshot CLI
# ==============================================================================

set -euo pipefail

VERSION="0.1.0"

# Default configuration (overridable via ~/.config/tmux-phoenix/config)
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-phoenix/config"
KEEP_SNAPSHOTS="${KEEP_SNAPSHOTS:-20}"
SAVE_INTERVAL="${SAVE_INTERVAL:-1}"
RESURRECT_PROCESSES="${RESURRECT_PROCESSES:-:all:}"
CAPTURE_PANE_CONTENTS="${CAPTURE_PANE_CONTENTS:-off}"
AUTOSTART_SESSION="${AUTOSTART_SESSION:-__autostart}"

if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

SELF_BIN=$(readlink -f "$0")
PLUGIN_BASE="${HOME}/.tmux/plugins"
RESURRECT_PLUGIN="${PLUGIN_BASE}/tmux-resurrect"
SYSTEMD_USER_DIR="${HOME}/.config/systemd/user"
SERVICE_FILE="${SYSTEMD_USER_DIR}/tmux.service"

XDG_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf"
LEGACY_CONF="${HOME}/.tmux.conf"
DEFAULT_SHELL_NAME=$(basename "${SHELL:-bash}")

get_snapshot_dir() {
    local last_link
    last_link=$(ls -d "${HOME}/.local/share/tmux/resurrect/last" "${HOME}/.tmux/resurrect/last" 2>/dev/null | head -n 1 || true)
    if [ -n "$last_link" ]; then
        dirname "$last_link"
    elif [ -d "${HOME}/.local/share/tmux/resurrect" ]; then
        echo "${HOME}/.local/share/tmux/resurrect"
    else
        echo "${HOME}/.tmux/resurrect"
    fi
}

count_real_sessions() {
    { tmux list-sessions -F '#{session_name}' 2>/dev/null || true; } | \
        awk -v skip="$AUTOSTART_SESSION" '$0 != skip {c++} END {print c+0}'
}

run_resurrect_save() {
    local attempt
    for attempt in 1 2 3 4 5; do
        if tmux run-shell "${RESURRECT_PLUGIN}/scripts/save.sh" 2>/dev/null; then
            return 0
        fi
        sleep 1
    done
    return 1
}

prune_snapshots() {
    local keep="${1:-$KEEP_SNAPSHOTS}"
    local tail_start=$((keep + 1))
    local d active latest f removed=0

    for d in "${HOME}/.local/share/tmux/resurrect" "${HOME}/.tmux/resurrect"; do
        [ -d "$d" ] || continue

        # Remove scrollback archive and staging folder when scrollback capture is disabled
        if [ "$CAPTURE_PANE_CONTENTS" = "off" ]; then
            rm -rf "${d}/pane_contents.tar.gz" "${d}/save"
        fi

        # Strip leftover bootstrap session records (preserving mtime) and delete 0-byte or paneless snapshot files
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            if grep -q -E "^(pane|window)[[:space:]]+${AUTOSTART_SESSION}[[:space:]]+" "$f" 2>/dev/null; then
                touch -r "$f" "${d}/.mtime_ref"
                sed -i -E "/^(pane|window)\t${AUTOSTART_SESSION}\t/d" "$f"
                touch -r "${d}/.mtime_ref" "$f"
                rm -f "${d}/.mtime_ref"
            fi
            if ! grep -q -E "^pane	" "$f" 2>/dev/null; then
                rm -f "$f"
            fi
        done < <(find "$d" -maxdepth 1 -name 'tmux_resurrect_*.txt' -size +0c 2>/dev/null)
        find "$d" -maxdepth 1 -name 'tmux_resurrect_*.txt' -size 0 -delete

        # Repair 'last' symlink if missing or pointing to a deleted/empty file
        if [ ! -s "${d}/last" ]; then
            rm -f "${d}/last"
            latest=$(ls -1t "${d}"/tmux_resurrect_*.txt 2>/dev/null | head -n 1 || true)
            if [ -n "$latest" ]; then
                ln -sf "$(basename "$latest")" "${d}/last"
                echo "Repaired ${d}/last -> $(basename "$latest")"
            fi
        fi

        # Protect whichever snapshot 'last' targets (even if manually pinned to an older file)
        active=$(readlink -f "${d}/last" 2>/dev/null || true)

        while IFS= read -r f; do
            [ -n "$f" ] || continue
            if [ "$(readlink -f "$f" 2>/dev/null || true)" != "$active" ]; then
                rm -f "$f"
                removed=$((removed + 1))
            fi
        done < <(ls -1t "${d}"/tmux_resurrect_*.txt 2>/dev/null | tail -n "+${tail_start}")
    done

    if [ "$removed" -gt 0 ]; then
        echo "Pruned ${removed} old snapshot(s) (retaining ${keep} most recent)."
    fi
}

get_last_snapshot() {
    prune_snapshots "$KEEP_SNAPSHOTS"
    local dir
    dir=$(get_snapshot_dir)
    if [ ! -L "${dir}/last" ] || [ ! -s "${dir}/last" ]; then
        return 1
    fi
    readlink -f "${dir}/last"
}

validate_snapshot() {
    local file="$1"
    if [ ! -s "$file" ]; then
        echo "Validation failed: Snapshot file '$file' is empty or missing." >&2
        return 1
    fi

    awk -F'\t' '
    BEGIN { err = 0; panes = 0 }
    /^[[:space:]]*$/ { next }
    $1 == "pane" {
        panes++
        if (NF != 11) {
            printf "Line %d: pane record has %d fields (expected 11). Check for spaces replacing tabs.\n", NR, NF > "/dev/stderr"
            err = 1
        }
        if (substr($8, 1, 1) != ":") {
            printf "Line %d: directory field ($8) is missing leading colon (:).\n", NR > "/dev/stderr"
            err = 1
        }
        if (substr($11, 1, 1) != ":") {
            printf "Line %d: command field ($11) is missing leading colon (:).\n", NR > "/dev/stderr"
            err = 1
        }
        next
    }
    $1 == "window" {
        if (NF != 8) {
            printf "Line %d: window record has %d fields (expected 8).\n", NR, NF > "/dev/stderr"
            err = 1
        }
        next
    }
    $1 == "state" || $1 == "grouped_session" { next }
    {
        printf "Line %d: unknown record type \"%s\".\n", NR, $1 > "/dev/stderr"
        err = 1
    }
    END {
        if (panes == 0) {
            printf "Validation failed: No pane records found in snapshot.\n" > "/dev/stderr"
            err = 1
        }
        exit err
    }' "$file"
}

is_boilerplate_conf() {
    local conf="$1"
    local non_script_lines
    non_script_lines=$(sed '/# BEGIN TMUX-PHOENIX/,/# END TMUX-PHOENIX/d; /# BEGIN TMUX PERSISTENCE/,/# END TMUX PERSISTENCE/d; /tpm\/tpm/d; /tmux-sensible/d; /TMUX_PLUGIN_MANAGER_PATH/d; /destroy-unattached/d; /exit-unattached/d; /^[[:space:]]*#/d; /^[[:space:]]*$/d' "$conf" | awk 'END {print NR+0}')
    [ "$non_script_lines" -eq 0 ]
}

resolve_tmux_conf() {
    if [ -f "$LEGACY_CONF" ]; then
        echo "$LEGACY_CONF"
    elif [ -f "$XDG_CONF" ]; then
        echo "$XDG_CONF"
    else
        echo "$LEGACY_CONF"
    fi
}

reconcile_tmux_conf() {
    if [ -f "$XDG_CONF" ] && [ -f "$LEGACY_CONF" ]; then
        if is_boilerplate_conf "$LEGACY_CONF"; then
            rm -f "$LEGACY_CONF"
            echo "$XDG_CONF"
            return
        elif is_boilerplate_conf "$XDG_CONF"; then
            rm -f "$XDG_CONF"
            echo "$LEGACY_CONF"
            return
        else
            mv -f "$XDG_CONF" "${XDG_CONF}.bak"
            echo "Moved conflicting ${XDG_CONF} -> ${XDG_CONF}.bak so tmux and TPM use ${LEGACY_CONF}" >&2
            echo "$LEGACY_CONF"
            return
        fi
    fi
    resolve_tmux_conf
}

cmd_list() {
    local file
    if ! file=$(get_last_snapshot); then
        echo "No valid snapshot found. Run '${0##*/} save' first." >&2
        return 1
    fi

    echo "Active snapshot: ${file}"
    echo ""
    awk -F'\t' '
    BEGIN {
        printf "%-22s %-42s %-15s %s\n", "SESSION:WIN.PANE", "WORKING DIRECTORY", "PROCESS", "COMMAND TO RESTORE"
        printf "%-22s %-42s %-15s %s\n", "----------------", "-----------------", "-------", "------------------"
    }
    $1 == "pane" {
        target = $2 ":" $3 "." $6
        dir = substr($8, 2)
        proc = $10
        cmd = substr($11, 2)
        if (cmd == "") cmd = "(idle shell)"
        printf "%-22s %-42s %-15s %s\n", target, dir, proc, cmd
    }' "$file"
}

cmd_save() {
    if ! tmux list-sessions >/dev/null 2>&1; then
        echo "Error: No active tmux server is running." >&2
        exit 1
    fi
    if ! run_resurrect_save; then
        echo "Error: Failed to trigger tmux-resurrect save.sh." >&2
        exit 1
    fi
    prune_snapshots "$KEEP_SNAPSHOTS"
    echo "Saved current tmux sessions."
    cmd_list
}

cmd_restore() {
    local file
    if ! file=$(get_last_snapshot); then
        echo "No valid snapshot found to restore." >&2
        return 1
    fi

    if ! tmux list-sessions >/dev/null 2>&1; then
        tmux new-session -d -s "$AUTOSTART_SESSION"
    fi

    tmux run-shell "${RESURRECT_PLUGIN}/scripts/restore.sh" || true

    if [ "$(count_real_sessions)" -gt 0 ]; then
        tmux kill-session -t "$AUTOSTART_SESSION" 2>/dev/null || true
    fi

    echo "Restored sessions from $(basename "$file"):"
    tmux ls 2>/dev/null || true
}

cmd_set() {
    if [ "$#" -lt 2 ]; then
        echo "Usage: ${0##*/} set SESSION:WIN.PANE \"COMMAND\" [DIRECTORY]" >&2
        exit 1
    fi

    local target="$1"
    local new_cmd="$2"
    local new_dir="${3:-}"
    local src_file dir timestamp new_file tmp_out proc_name

    if ! src_file=$(get_last_snapshot); then
        echo "Error: No active snapshot found. Run '${0##*/} save' first." >&2
        exit 1
    fi

    dir=$(dirname "$src_file")
    timestamp=$(date +%Y%m%dT%H%M%S)
    new_file="${dir}/tmux_resurrect_${timestamp}.txt"
    tmp_out=$(mktemp "${dir}/.tmux_resurrect_tmp.XXXXXX")

    if [ -z "$new_cmd" ]; then
        proc_name="$DEFAULT_SHELL_NAME"
    else
        proc_name=$(awk '{print $1}' <<< "$new_cmd")
        proc_name=$(basename "$proc_name")
    fi

    awk -F'\t' -v OFS='\t' \
        -v target="$target" \
        -v new_cmd="$new_cmd" \
        -v new_dir="$new_dir" \
        -v proc_name="$proc_name" '
    BEGIN { matched = 0 }
    $1 == "pane" {
        curr_target = $2 ":" $3 "." $6
        if (curr_target == target) {
            matched = 1
            if (new_dir != "") $8 = ":" new_dir
            $10 = proc_name
            $11 = ":" new_cmd
        }
    }
    { print }
    END {
        if (!matched) {
            printf "Error: Target pane \"%s\" not found in snapshot.\n", target > "/dev/stderr"
            exit 2
        }
    }' "$src_file" > "$tmp_out" || {
        rm -f "$tmp_out"
        exit 1
    }

    if validate_snapshot "$tmp_out"; then
        mv -f "$tmp_out" "$new_file"
        ln -sf "$(basename "$new_file")" "${dir}/last"
        prune_snapshots "$KEEP_SNAPSHOTS"
        echo "Updated ${target} and pointed 'last' to $(basename "$new_file")."
    else
        rm -f "$tmp_out"
        exit 1
    fi
}

cmd_edit() {
    local src_file dir timestamp new_file tmp_out tmp_edit editor before_hash after_hash
    if ! src_file=$(get_last_snapshot); then
        echo "Error: No active snapshot found. Run '${0##*/} save' first." >&2
        exit 1
    fi

    dir=$(dirname "$src_file")
    tmp_edit=$(mktemp /tmp/tmux_phoenix_edit.XXXXXX.tsv)
    trap 'rm -f "${tmp_edit:-}" "${tmp_out:-}"' EXIT

    cat << 'EOF' > "$tmp_edit"
# Edit WORKING_DIRECTORY and COMMAND for any pane below.
# IMPORTANT: Keep fields separated by a single TAB character.
# Leave COMMAND empty to restore an idle shell in that directory.
# TARGET	WORKING_DIRECTORY	COMMAND
EOF

    awk -F'\t' -v OFS='\t' '
    $1 == "pane" {
        target = $2 ":" $3 "." $6
        dir = substr($8, 2)
        cmd = substr($11, 2)
        print target, dir, cmd
    }' "$src_file" >> "$tmp_edit"

    before_hash=$(sha256sum "$tmp_edit" | awk '{print $1}')
    editor="${EDITOR:-nvim}"
    if [[ "$editor" == *vim* ]]; then
        "$editor" -c "set noexpandtab list" "$tmp_edit"
    else
        "$editor" "$tmp_edit"
    fi
    after_hash=$(sha256sum "$tmp_edit" | awk '{print $1}')

    if [ "$before_hash" = "$after_hash" ]; then
        rm -f "$tmp_edit"
        echo "No changes made."
        return 0
    fi

    timestamp=$(date +%Y%m%dT%H%M%S)
    new_file="${dir}/tmux_resurrect_${timestamp}.txt"
    tmp_out=$(mktemp "${dir}/.tmux_resurrect_tmp.XXXXXX")

    awk -F'\t' -v OFS='\t' -v default_shell="$DEFAULT_SHELL_NAME" '
    NR == FNR {
        if ($0 ~ /^[[:space:]]*#/ || $0 ~ /^[[:space:]]*$/) next
        if (NF < 2 || NF > 3) {
            printf "Edit error on line %d: expected 2 or 3 tab-separated columns, found %d.\n", FNR, NF > "/dev/stderr"
            err = 1
        }
        edit_dir[$1] = $2
        edit_cmd[$1] = (NF == 3) ? $3 : ""
        next
    }
    $1 == "pane" {
        target = $2 ":" $3 "." $6
        if (target in edit_dir) {
            $8 = ":" edit_dir[target]
            cmd = edit_cmd[target]
            if (cmd == "") {
                $10 = default_shell
                $11 = ":"
            } else {
                split(cmd, tokens, " ")
                proc = tokens[1]
                sub(/^.*\//, "", proc)
                $10 = proc
                $11 = ":" cmd
            }
        }
    }
    { print }
    END { exit err }
    ' "$tmp_edit" "$src_file" > "$tmp_out" || {
        rm -f "$tmp_out"
        echo "Aborted: Snapshot was not modified." >&2
        exit 1
    }

    if validate_snapshot "$tmp_out"; then
        mv -f "$tmp_out" "$new_file"
        rm -f "$tmp_edit"
        ln -sf "$(basename "$new_file")" "${dir}/last"
        prune_snapshots "$KEEP_SNAPSHOTS"
        echo "Changes validated and saved to $(basename "$new_file")."
    else
        rm -f "$tmp_out" "$tmp_edit"
        exit 1
    fi
}

cmd_status() {
    local dir count
    dir=$(get_snapshot_dir)
    count=$(find "$dir" -maxdepth 1 -name 'tmux_resurrect_*.txt' -size +0c 2>/dev/null | awk 'END {print NR+0}')

    echo "=== Systemd User Service ==="
    systemctl --user status tmux.service --no-pager || true
    echo ""
    echo "=== Tmux Plugin Environment ==="
    tmux show-environment -g TMUX_PLUGIN_MANAGER_PATH 2>/dev/null || echo "Tmux server not running."
    echo ""
    echo "=== Active Sessions ==="
    tmux ls 2>/dev/null || echo "No active sessions."
    echo ""
    echo "=== Snapshot Status (${count}/${KEEP_SNAPSHOTS} retained) ==="
    cmd_list || true
}

cmd_doctor() {
    local failures=0
    local tmux_conf dir plugin_path destroy_opt

    echo "Running tmux-phoenix diagnostics (v${VERSION})..."
    echo ""

    for cmd in git tmux systemctl loginctl sed find awk; do
        if command -v "$cmd" >/dev/null 2>&1; then
            echo "[PASS] Dependency available: $cmd"
        else
            echo "[FAIL] Missing required dependency: $cmd"
            failures=$((failures + 1))
        fi
    done

    for repo in tpm tmux-resurrect tmux-continuum; do
        if [ -d "${PLUGIN_BASE}/${repo}" ]; then
            echo "[PASS] Plugin installed: ${repo}"
        else
            echo "[FAIL] Plugin missing: ${PLUGIN_BASE}/${repo} (run 'tmux-phoenix setup')"
            failures=$((failures + 1))
        fi
    done

    if [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || echo no)" = "yes" ]; then
        echo "[PASS] Systemd user lingering enabled for $USER"
    else
        echo "[FAIL] Systemd user lingering disabled (run: sudo loginctl enable-linger $USER)"
        failures=$((failures + 1))
    fi

    if systemctl --user is-enabled tmux.service >/dev/null 2>&1; then
        echo "[PASS] tmux.service is enabled"
    else
        echo "[FAIL] tmux.service is not enabled"
        failures=$((failures + 1))
    fi

    if systemctl --user is-active tmux.service >/dev/null 2>&1; then
        echo "[PASS] tmux.service is active"
    else
        echo "[WARN] tmux.service is not currently active"
    fi

    tmux_conf=$(resolve_tmux_conf)
    if [ -f "$XDG_CONF" ] && [ -f "$LEGACY_CONF" ]; then
        echo "[FAIL] Split-brain config: both ${LEGACY_CONF} and ${XDG_CONF} exist (tmux reads ${LEGACY_CONF}, TPM reads ${XDG_CONF})"
        failures=$((failures + 1))
    else
        echo "[PASS] Single tmux config path resolved: ${tmux_conf}"
    fi

    if grep -q "# BEGIN TMUX-PHOENIX" "$tmux_conf" 2>/dev/null; then
        echo "[PASS] Managed block present in ${tmux_conf}"
    else
        echo "[FAIL] Managed block missing in ${tmux_conf}"
        failures=$((failures + 1))
    fi

    if tmux list-sessions >/dev/null 2>&1; then
        plugin_path=$(tmux show-environment -g TMUX_PLUGIN_MANAGER_PATH 2>/dev/null || true)
        if [[ "$plugin_path" == *"${HOME}/.tmux/plugins/"* ]]; then
            echo "[PASS] TMUX_PLUGIN_MANAGER_PATH properly expanded (${plugin_path})"
        else
            echo "[FAIL] TMUX_PLUGIN_MANAGER_PATH invalid or unexpanded (${plugin_path:-unset})"
            failures=$((failures + 1))
        fi

        destroy_opt=$(tmux show-options -gv destroy-unattached 2>/dev/null || echo "unset")
        if [ "$destroy_opt" = "off" ]; then
            echo "[PASS] destroy-unattached is off"
        else
            echo "[FAIL] destroy-unattached is '${destroy_opt}' (must be 'off')"
            failures=$((failures + 1))
        fi

        local status_right
        status_right=$(tmux show-options -gv status-right 2>/dev/null || true)
        if [[ "$status_right" == *"continuum_save.sh"* ]]; then
            echo "[PASS] tmux-continuum hook active in status-right"
        else
            echo "[FAIL] tmux-continuum hook missing from status-right (TPM did not load tmux-continuum)"
            failures=$((failures + 1))
        fi
    else
        echo "[WARN] Tmux server is not running; skipping live socket checks"
    fi

    dir=$(get_snapshot_dir)
    if [ -L "${dir}/last" ] && [ -s "${dir}/last" ] && validate_snapshot "$(readlink -f "${dir}/last")" 2>/dev/null; then
        echo "[PASS] Active snapshot valid: $(readlink -f "${dir}/last")"
    else
        echo "[WARN] No valid snapshot currently at ${dir}/last"
    fi

    echo ""
    if [ "$failures" -gt 0 ]; then
        echo "Doctor found ${failures} error(s)."
        exit 1
    fi
    echo "All checks passed."
}

cmd_setup() {
    echo "[1/5] Checking dependencies..."
    for cmd in git tmux systemctl loginctl sed find awk; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            echo "Error: Required command '$cmd' not found in PATH." >&2
            exit 1
        fi
    done

    echo "[2/5] Installing TPM, tmux-resurrect, and tmux-continuum..."
    mkdir -p "$PLUGIN_BASE"
    for repo in tpm tmux-resurrect tmux-continuum; do
        target="${PLUGIN_BASE}/${repo}"
        if [ ! -d "$target" ]; then
            echo "Cloning ${repo}..."
            git clone --depth 1 "https://github.com/tmux-plugins/${repo}.git" "$target"
        else
            echo "Updating ${repo}..."
            git -C "$target" pull --ff-only
        fi
    done
    chmod +x "${PLUGIN_BASE}/tpm/tpm" "${PLUGIN_BASE}/tpm/scripts/"*.sh \
        "${PLUGIN_BASE}/tmux-resurrect/"*.tmux "${PLUGIN_BASE}/tmux-resurrect/scripts/"*.sh \
        "${PLUGIN_BASE}/tmux-continuum/"*.tmux "${PLUGIN_BASE}/tmux-continuum/scripts/"*.sh 2>/dev/null || true

    echo "[3/5] Resolving and configuring tmux configuration file..."
    local tmux_conf
    tmux_conf=$(reconcile_tmux_conf)
    echo "Using configuration file: ${tmux_conf}"
    mkdir -p "$(dirname "$tmux_conf")"
    touch "$tmux_conf"

    sed -i '/# BEGIN TMUX-PHOENIX/,/# END TMUX-PHOENIX/d' "$tmux_conf"
    sed -i '/# BEGIN TMUX PERSISTENCE/,/# END TMUX PERSISTENCE/d' "$tmux_conf"
    sed -i '/TMUX_PLUGIN_MANAGER_PATH/d; /destroy-unattached/d; /exit-unattached/d' "$tmux_conf"
    sed -i "\|run '~/.tmux/plugins/tpm/tpm'|d" "$tmux_conf"
    sed -i '\|run "~/.tmux/plugins/tpm/tpm"|d' "$tmux_conf"

    cat << EOF >> "$tmux_conf"

# BEGIN TMUX-PHOENIX
set -g destroy-unattached off
set -g exit-unattached off
run-shell "tmux set-environment -g TMUX_PLUGIN_MANAGER_PATH $HOME/.tmux/plugins/"
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

set -g @continuum-boot 'on'
set -g @continuum-restore 'on'
set -g @continuum-save-interval '${SAVE_INTERVAL}'
set -g @resurrect-processes '${RESURRECT_PROCESSES}'
set -g @resurrect-capture-pane-contents '${CAPTURE_PANE_CONTENTS}'
set -g @resurrect-hook-post-save-all '${SELF_BIN} _hook-post-save'
# END TMUX-PHOENIX
run '~/.tmux/plugins/tpm/tpm'
EOF

    echo "[4/5] Pruning snapshots and syncing active tmux server..."
    prune_snapshots "$KEEP_SNAPSHOTS"

    if tmux list-sessions >/dev/null 2>&1; then
        for hook in session-created session-closed window-linked window-unlinked after-split-window client-detached; do
            tmux set-hook -gu "$hook" 2>/dev/null || true
        done
        tmux source-file "$tmux_conf"
    fi

    echo "[5/5] Configuring systemd user service, user lingering, and restoring sessions..."
    mkdir -p "$SYSTEMD_USER_DIR"

    systemctl --user stop tmux.service 2>/dev/null || true
    systemctl --user reset-failed tmux.service 2>/dev/null || true

    cat << EOF > "$SERVICE_FILE"
[Unit]
Description=Tmux Server Daemon (managed by tmux-phoenix)
Documentation=man:tmux(1)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStartPre=${SELF_BIN} _hook-pre-start
ExecStart=/bin/sh -c '/usr/bin/tmux has-session -t ${AUTOSTART_SESSION} 2>/dev/null || /usr/bin/tmux new-session -d -s ${AUTOSTART_SESSION}'
ExecStartPost=${SELF_BIN} _hook-post-start
ExecStop=/bin/sh -c '/usr/bin/tmux kill-server 2>/dev/null || true'

[Install]
WantedBy=default.target
EOF

    systemctl --user daemon-reload
    systemctl --user enable --now tmux.service

    local real_sessions
    real_sessions=$(count_real_sessions)

    if [ "$real_sessions" -eq 0 ] && get_last_snapshot >/dev/null 2>&1; then
        echo "Valid snapshot found and no real sessions active. Restoring saved sessions..."
        cmd_restore
    elif [ "$real_sessions" -gt 0 ]; then
        if run_resurrect_save; then
            prune_snapshots "$KEEP_SNAPSHOTS"
            echo "Saved active sessions to snapshot."
        fi
    fi

    if [ "$(loginctl show-user "$USER" -p Linger --value)" != "yes" ]; then
        echo "Enabling systemd user linger (may prompt for sudo password)..."
        sudo loginctl enable-linger "$USER"
    fi

    echo ""
    echo "Setup complete."
    cmd_status
}

cmd_uninstall() {
    echo "Disabling and removing tmux.service..."
    systemctl --user disable --now tmux.service 2>/dev/null || true
    rm -f "$SERVICE_FILE"
    systemctl --user daemon-reload

    local tmux_conf
    tmux_conf=$(resolve_tmux_conf)
    if [ -f "$tmux_conf" ]; then
        sed -i '/# BEGIN TMUX-PHOENIX/,/# END TMUX-PHOENIX/d' "$tmux_conf"
        sed -i '/# BEGIN TMUX PERSISTENCE/,/# END TMUX PERSISTENCE/d' "$tmux_conf"
        echo "Removed managed configuration block from ${tmux_conf}."
    fi

    echo "Uninstall complete. Snapshot files in $(get_snapshot_dir) were preserved."
}

case "${1:-status}" in
    setup|install)
        cmd_setup
        ;;
    uninstall)
        cmd_uninstall
        ;;
    restore)
        cmd_restore
        ;;
    save)
        cmd_save
        ;;
    prune)
        prune_snapshots "${2:-$KEEP_SNAPSHOTS}"
        ;;
    list|ls)
        cmd_list
        ;;
    set)
        shift
        cmd_set "$@"
        ;;
    edit)
        cmd_edit
        ;;
    status)
        cmd_status
        ;;
    doctor)
        cmd_doctor
        ;;
    version|--version|-v)
        echo "tmux-phoenix ${VERSION}"
        ;;
    _hook-pre-start)
        prune_snapshots "$KEEP_SNAPSHOTS"
        ;;
    _hook-post-start)
        sleep 3
        if [ "$(count_real_sessions)" -eq 0 ] && get_last_snapshot >/dev/null 2>&1; then
            cmd_restore >/dev/null 2>&1 || true
        elif [ "$(count_real_sessions)" -gt 0 ]; then
            tmux kill-session -t "$AUTOSTART_SESSION" 2>/dev/null || true
        fi
        ;;
    _hook-post-save)
        prune_snapshots "$KEEP_SNAPSHOTS"
        ;;
    *)
        echo "Usage: ${0##*/} {setup|uninstall|restore|save|prune|list|set|edit|status|doctor|version}" >&2
        exit 1
        ;;
esac
